<!-- report_submit.html -->
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>課題提出 - Prototype</title>
  <style>
    :root{
      --bg:#f5f7fb;
      --card:#ffffff;
      --border:#e5e7eb;
      --text:#111827;
      --muted:#6b7280;
      --shadow:0 10px 28px rgba(16,24,40,.12);
      --dark:#2f2f2f;
      --orange:#ee964b;
      --orangeHover:#e88736;
      --radius2:16px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans JP","Hiragino Sans","Yu Gothic",sans-serif;
      color:var(--text);
      background:var(--bg);
      font-size:14px;
      line-height:1.6;
    }
    .container{ max-width:1240px; margin:0 auto; padding:0 16px; }

    /* top bar (提出画面風) */
    .topbar{
      height:56px;
      background:var(--dark);
      color:#fff;
      display:flex;
      align-items:center;
      box-shadow:0 2px 12px rgba(0,0,0,.2);
      position:sticky;
      top:0;
      z-index:50;
    }
    .topinner{
      width:100%;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }
    .crumb{
      display:flex;
      align-items:center;
      gap:10px;
      font-weight:900;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      opacity:.95;
    }
    .crumb small{ font-weight:800; opacity:.9; }
    .topBtns{ display:flex; align-items:center; gap:10px; white-space:nowrap; }
    .btn{
      border:none;
      cursor:pointer;
      font-weight:900;
      border-radius:10px;
      height:34px;
      padding:0 12px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      background:#fff;
      color:#111827;
    }
    .btnGhost{
      background:transparent;
      color:#fff;
      border:1px solid rgba(255,255,255,.25);
    }
    .btnGhost:hover{ background:rgba(255,255,255,.08); }

    /* main split */
    .main{ padding:18px 0 48px; }
    .split{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:14px;
      align-items:start;
    }
    .panel{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:var(--radius2);
      box-shadow:var(--shadow);
      overflow:hidden;
      min-height:640px;
    }
    .panelHead{
      display:flex;
      gap:18px;
      padding:14px 16px 10px;
      border-bottom:1px solid var(--border);
      font-weight:900;
    }
    .tab{
      color:var(--muted);
      padding-bottom:8px;
      border-bottom:3px solid transparent;
    }
    .tab.active{
      color:var(--text);
      border-bottom-color:var(--orange);
    }
    .panelBody{ padding:16px; }

    /* right content */
    .rowTop{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
    }
    .xpPill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:4px 10px;
      border-radius:999px;
      border:1px solid var(--orange);
      color:var(--orange);
      font-weight:900;
      font-size:12px;
      white-space:nowrap;
      height:28px;
    }
    .uploadBtn{
      background:var(--orange);
      color:#fff;
      border:none;
      border-radius:12px;
      height:42px;
      padding:0 16px;
      font-weight:900;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      min-width:140px;
    }
    .uploadBtn:hover{ background:var(--orangeHover); }
    .muted{ color:var(--muted); font-weight:800; font-size:12px; line-height:1.7; }
    .warn{
      margin-top:12px;
      border:2px solid #f59e0b;
      background:#fff7ed;
      border-radius:12px;
      padding:12px;
      font-weight:800;
      font-size:12px;
      line-height:1.75;
    }
    .warn b{ display:block; margin-bottom:6px; }
    textarea{
      width:100%;
      min-height:110px;
      border:1px solid var(--border);
      border-radius:12px;
      padding:10px 12px;
      font: inherit;
      resize:vertical;
      margin-top:10px;
    }
    .submitWrap{
      display:flex;
      justify-content:center;
      margin-top:18px;
    }
    .submitBtn{
      background:#f4c9a3;
      color:#fff;
      border:none;
      border-radius:12px;
      height:44px;
      padding:0 18px;
      font-weight:900;
      min-width:220px;
      cursor:not-allowed;
      opacity:.9;
    }

    @media (max-width: 980px){
      .split{ grid-template-columns:1fr; }
    }
  </style>
</head>
<body>
  <script>
    // auth guard（未ログインならログインへ）
    if (localStorage.getItem("aas_logged_in") !== "1") {
      location.replace("./index.html");
    }
    // org 未選択なら organizations へ
    if (!localStorage.getItem("aas_org")) {
      location.replace("./organizations.html");
    }
  </script>

  <div class="topbar">
    <div class="topinner container">
      <div class="crumb" title="（プロトタイプ）課題提出">
        <span style="display:inline-flex;align-items:center;gap:10px;">
          <span style="width:22px;height:22px;display:inline-block;background:#fff;clip-path:polygon(50% 5%,95% 90%,5% 90%);opacity:.9;"></span>
          <small>【新機能デモ用】生成AIを活用したデータ分析（Excel+生成AI）</small>
        </span>
        <span style="opacity:.7;">›</span>
        <small>分析方針の検討</small>
        <span style="opacity:.7;">›</span>
        <small>データ分析仮説を立てる：課題提出</small>
      </div>

      <div class="topBtns">
        <button class="btn btnGhost" type="button" onclick="alert('プロトタイプ：未実装です');">「ブックマーク」に保存</button>
        <button class="btn btnGhost" type="button" onclick="history.back();">前へ</button>
        <button class="btn btnGhost" type="button" onclick="alert('プロトタイプ：未実装です');">次へ</button>
        <button class="btn btnGhost" type="button" onclick="location.href='./quest.html';">≡</button>
      </div>
    </div>
  </div>

  <main class="main">
    <div class="container">
      <div class="split">
        <!-- Left: 説明 -->
        <section class="panel">
          <div class="panelHead">
            <div class="tab active">説明</div>
          </div>
          <div class="panelBody">
            <h2 style="margin:0 0 8px;font-size:18px;font-weight:900;">データ分析仮説を立てる：課題提出</h2>
            <div class="muted">
              「データ分析仮説を立てる：実践演習」を見てから、指示に従って課題を提出しましょう。<br>
              （プロトタイプ：実データや提出は未接続です）
            </div>
          </div>
        </section>

        <!-- Right: 投稿 -->
        <section class="panel">
          <div class="panelHead">
            <div class="tab active">投稿</div>
            <div class="tab">投稿履歴</div>
          </div>
          <div class="panelBody">
            <div class="rowTop">
              <div style="font-weight:900;">作成したプロンプトをPDFもしくはzipファイルにして提出しましょう。</div>
              <div class="xpPill">50 Exp</div>
            </div>

            <div style="margin-top:12px;">
              <label class="uploadBtn" for="fileInput">ファイル選択</label>
              <input id="fileInput" type="file" style="display:none" />
            </div>

            <div class="muted" style="margin-top:10px;">
              PDFまたはZIPファイルをアップロードできます<br>
              <span style="color:#ef4444;font-weight:900;">※ 最大30MB、ファイル名は半角英数字のみ使用可能</span>
            </div>

            <div class="warn">
              <b>⚠️ 以下の内容を含むファイル・メモのアップロードを行わないようにご注意ください。</b>
              1. 機密情報・個人情報を含むもの<br>
              2. 著作権や肖像権を侵害するもの<br>
              3. 誹謗中傷や公序良俗に反する内容<br>
              4. その他、本サービスの利用目的（学習・演習）から逸脱したもの
            </div>

            <div style="margin-top:14px;font-weight:900;">メモ（200字まで）</div>
            <textarea placeholder="メモを入力してください（任意）"></textarea>
            <div class="muted" style="text-align:right;margin-top:6px;">0 / 200</div>

            <div class="submitWrap">
              <button class="submitBtn" type="button" disabled>✈ 投稿する</button>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</body>
</html>
